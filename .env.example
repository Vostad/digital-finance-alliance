# FINANCIAL RAILS OS — environment.
#
# Copy to .env.local for development. `.env` and `.env.*` are gitignored; only
# this example file is tracked. NOTHING here is VITE_-prefixed, and nothing here
# may become VITE_-prefixed: that prefix is what makes Vite inline a value into
# the browser bundle.

# ---------------------------------------------------------------- database ---
# RUNTIME. Supabase → Project Settings → Database → Connection string →
# "Transaction pooler". Host ends in .pooler.supabase.com, port is 6543.
# The app refuses to start on anything else; see src/server/env.server.ts.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# MIGRATIONS ONLY, used by drizzle-kit. SESSION mode — the SAME pooler host as
# above, port 5432 instead of 6543. DDL needs session state the transaction
# pooler does not keep.
#
# NOT db.<project-ref>.supabase.co. Supabase's direct host is IPv6-only on
# current projects and does not resolve from an IPv4 network — it fails with
# ENOTFOUND, which reads like a bad password rather than a routing problem.
# The session-mode pooler is the supported replacement and does full DDL.
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------------- auth ---
SUPABASE_URL="https://<project-ref>.supabase.co"

# Public by design — it ships to browsers and is useless on its own, because
# RLS is default-deny on every table (drizzle/0001_rls_default_deny.sql).
SUPABASE_ANON_KEY="<anon key>"

# SERVER ONLY. Bypasses RLS entirely and can mint a session for any user.
# `npm run build` fails if this name or its value appears in client output.
# If it is ever exposed, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"
